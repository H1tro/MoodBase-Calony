# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase Dashboard → Project Settings → API / API Keys).
# Both values are meant to be public: what a player can read or write is
# limited by Row Level Security in supabase/schema.sql.
# NEVER put the "service_role" / secret key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older projects show a legacy "anon" key instead; you can use it like this:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
